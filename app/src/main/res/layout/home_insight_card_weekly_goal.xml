<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/weeklyGoalInsightCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/home_insight_card_min_height"
    app:cardBackgroundColor="@color/formula_details_bg"
    app:cardCornerRadius="@dimen/home_card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/home_card_padding">

        <TextView
            android:id="@+id/weeklyGoalInsightTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_weekly_goal"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weeklyGoalInsightStatusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_card_inner_gap"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/weeklyGoalInsightRingsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/weeklyGoalInsightStatusCircle"
                layout="@layout/home_insight_weekly_goal_status_circle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/home_insight_ring_gap" />

            <include
                android:id="@+id/weeklyGoalInsightWorkoutsRing"
                layout="@layout/home_insight_weekly_goal_ring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/home_insight_ring_gap" />

            <include
                android:id="@+id/weeklyGoalInsightMinutesRing"
                layout="@layout/home_insight_weekly_goal_ring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
