<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeInsightsSection"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeInsightsPager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_insight_card_min_height"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/homeInsightsPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:tabBackground="@drawable/home_insight_page_indicator"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabMaxWidth="12dp"
        app:tabMinWidth="12dp"
        app:tabPaddingEnd="4dp"
        app:tabPaddingStart="4dp" />

</LinearLayout>
