<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workoutMetricsSnapshot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/formula_details_background"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/workoutMetricsSnapshotTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_workout_metrics_snapshot"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/workoutMetricsSnapshotStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>
