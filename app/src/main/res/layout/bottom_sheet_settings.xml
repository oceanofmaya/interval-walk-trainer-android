<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/background"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bottom_sheet_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/appVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/workout_settings"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:ellipsize="none" />

    <FrameLayout
        android:id="@+id/vibrationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vibrationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vibration"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="80dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            android:clickable="false"
            android:focusable="false"
            app:icon="@drawable/ic_vibration"
            app:iconGravity="start"
            app:iconTint="@color/text_secondary"
            app:iconPadding="12dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/vibrationSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/voiceNotificationsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voiceNotificationsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_notifications"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="80dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            android:clickable="false"
            android:focusable="false"
            app:icon="@drawable/ic_voice"
            app:iconGravity="start"
            app:iconTint="@color/text_secondary"
            app:iconPadding="12dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/voiceNotificationsSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/notificationsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notifications"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="80dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            android:clickable="false"
            android:focusable="false"
            app:icon="@drawable/ic_notifications"
            app:iconGravity="start"
            app:iconTint="@color/text_secondary"
            app:iconPadding="12dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationsSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/keepScreenAwakeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keepScreenAwakeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_screen_awake"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="80dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            android:clickable="false"
            android:focusable="false"
            app:icon="@drawable/ic_timer"
            app:iconGravity="start"
            app:iconTint="@color/text_secondary"
            app:iconPadding="12dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/keepScreenAwakeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color" />
    </FrameLayout>

    <!-- Countdown toggle row - using same pattern as working buttons -->
    <FrameLayout
        android:id="@+id/startCountdownRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/countdownLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Countdown"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="120dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            android:clickable="false"
            android:focusable="false"
            app:icon="@drawable/ic_timer"
            app:iconGravity="start"
            app:iconTint="@color/text_secondary"
            app:iconPadding="12dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/startCountdownValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3s"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/startCountdownDecrease"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_remove"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Decrease"
                app:tint="@color/text_secondary"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/startCountdownIncrease"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Increase"
                app:tint="@color/text_secondary"
                android:scaleType="centerInside" />
            
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/startCountdownSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
        </LinearLayout>
    </FrameLayout>

    <!-- Controls visibility wrapper for countdown (used by code) -->
    <View
        android:id="@+id/startCountdownControls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Save Workouts toggle row -->
    <FrameLayout
        android:id="@+id/saveWorkoutsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveWorkoutsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Workouts"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="80dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            android:clickable="false"
            android:focusable="false"
            app:icon="@drawable/ic_save"
            app:iconGravity="start"
            app:iconTint="@color/text_secondary"
            app:iconPadding="12dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />
        
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/saveWorkoutsSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clearStatsButton"
        style="@style/Widget.IntervalWalkTrainer.SettingsActionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clear_stats"
        app:icon="@drawable/outline_delete_24"
        app:iconSize="24dp" />
    
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/stroke_light" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/theme_mode"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:ellipsize="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/themeSystemButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/theme_swatch_unselected_bg"
            android:src="@drawable/swatch_theme_system"
            android:contentDescription="@string/theme_system"
            android:padding="4dp"
            app:tint="@null" />

        <ImageButton
            android:id="@+id/themeLightButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/theme_swatch_unselected_bg"
            android:src="@drawable/swatch_theme_light"
            android:contentDescription="@string/theme_light"
            android:padding="4dp"
            app:tint="@null" />

        <ImageButton
            android:id="@+id/themeDarkButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/theme_swatch_unselected_bg"
            android:src="@drawable/swatch_theme_dark"
            android:contentDescription="@string/theme_dark"
            android:padding="4dp"
            app:tint="@null" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/accent_mode"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:ellipsize="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/accentBlueButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/theme_swatch_unselected_bg"
            android:src="@drawable/swatch_accent_blue"
            android:contentDescription="@string/accent_blue"
            android:padding="4dp"
            app:tint="@null" />

        <ImageButton
            android:id="@+id/accentTealButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/theme_swatch_unselected_bg"
            android:src="@drawable/swatch_accent_teal"
            android:contentDescription="@string/accent_teal"
            android:padding="4dp"
            app:tint="@null" />

        <ImageButton
            android:id="@+id/accentPurpleButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/theme_swatch_unselected_bg"
            android:src="@drawable/swatch_accent_purple"
            android:contentDescription="@string/accent_purple"
            android:padding="4dp"
            app:tint="@null" />

        <ImageButton
            android:id="@+id/accentAmberButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/theme_swatch_unselected_bg"
            android:src="@drawable/swatch_accent_amber"
            android:contentDescription="@string/accent_amber"
            android:padding="4dp"
            app:tint="@null" />

        <ImageButton
            android:id="@+id/accentMagentaButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/theme_swatch_unselected_bg"
            android:src="@drawable/swatch_accent_magenta"
            android:contentDescription="@string/accent_magenta"
            android:padding="4dp"
            app:tint="@null" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/stroke_light" />
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:ellipsize="none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/privacyPolicyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/privacy_policy"
        app:icon="@drawable/ic_privacy"
        style="@style/Widget.IntervalWalkTrainer.SettingsActionButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/termsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/terms_and_conditions"
        app:icon="@drawable/ic_terms"
        style="@style/Widget.IntervalWalkTrainer.SettingsActionButton" />


    <View
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
