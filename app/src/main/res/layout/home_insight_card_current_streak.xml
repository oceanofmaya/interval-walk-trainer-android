<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/currentStreakInsightCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/home_insight_card_min_height"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/home_card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/home_insight_card_padding">

        <TextView
            android:id="@+id/currentStreakInsightTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_current_streak"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/currentStreakInsightVisualRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_insight_rings_margin_top"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/currentStreakInsightStatusCircle"
                layout="@layout/home_insight_weekly_goal_status_circle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/home_insight_ring_gap" />

            <include
                android:id="@+id/currentStreakInsightDaysCircle"
                layout="@layout/home_insight_flat_stat_circle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/home_insight_ring_gap" />

            <TextView
                android:id="@+id/currentStreakInsightBestText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
