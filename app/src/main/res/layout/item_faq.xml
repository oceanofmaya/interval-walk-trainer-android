<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/faq_entry_spacing_bottom">

    <FrameLayout
        android:id="@+id/faqItemHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/faqItemQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="@dimen/faq_item_padding_horizontal"
            android:paddingEnd="@dimen/faq_item_padding_horizontal"
            android:textSize="@dimen/faq_question_text_size"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/faqItemChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/baseline_chevron_right_24"
            app:tint="@color/text_secondary"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/faqItemAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp"
        android:paddingStart="@dimen/faq_item_padding_horizontal"
        android:paddingEnd="@dimen/faq_item_padding_horizontal"
        android:paddingBottom="16dp" />

</LinearLayout>
