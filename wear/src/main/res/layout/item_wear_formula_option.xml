<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/wear_picker_item_height"
    android:layout_gravity="center_horizontal">

    <LinearLayout
        android:id="@+id/optionCard"
        android:layout_width="@dimen/wear_picker_card_width"
        android:layout_height="@dimen/wear_picker_card_height"
        android:layout_gravity="center"
        android:background="@drawable/wear_formula_selector"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/wear_picker_card_padding_start"
        android:paddingEnd="@dimen/wear_picker_card_padding_end">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/formulaName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wear_picker_name_height"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/wear_text_primary"
                android:textSize="@dimen/wear_picker_name_text_size" />

            <TextView
                android:id="@+id/formulaDuration"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wear_picker_duration_height"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/wear_text_secondary"
                android:textSize="@dimen/wear_picker_duration_text_size" />
        </LinearLayout>

        <ImageView
            android:id="@+id/selectedCheck"
            android:layout_width="@dimen/wear_picker_check_size"
            android:layout_height="@dimen/wear_picker_check_size"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/baseline_check_24"
            android:tint="@color/wear_accent"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
